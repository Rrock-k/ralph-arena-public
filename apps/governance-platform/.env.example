# Database Configuration (PostgreSQL)
# For local development, run: docker compose up postgres -d
DATABASE_URL="postgresql://ralph:ralph@localhost:5433/ralph_arena"
# Explicit DB backup root for direct standalone governance runs.
# Local Docker gets a default from scripts/docker-local-stack.sh.
ARENA_DB_BACKUP_ROOT=""
ARENA_DB_BACKUP_INTERVAL_MS="21600000"
ARENA_DB_BACKUP_INITIAL_DELAY_MS="300000"
ARENA_DB_BACKUP_KEEP_ALL_HOURS="48"
ARENA_DB_BACKUP_KEEP_DAILY_DAYS="14"
ARENA_DB_BACKUP_KEEP_WEEKLY_WEEKS="8"
ARENA_DB_BACKUP_KEEP_MONTHLY_MONTHS="6"
# Optional: dedicated DB for Playwright e2e (prevents test data in dev DB)
# PLAYWRIGHT_DATABASE_URL="postgresql://ralph:ralph@localhost:5434/ralph_arena_e2e"

# NextAuth.js Authentication
# Generate a secure secret with: openssl rand -base64 32
# IMPORTANT: Change this value in production!
NEXTAUTH_SECRET=""
# Optional explicit preview auth signing secret. Defaults to NEXTAUTH_SECRET when empty.
AUTH_SECRET=""

# NextAuth.js URL Configuration
# The base URL of your application
# For local development: http://localhost:3000
# For production: https://yourdomain.com
# IMPORTANT: Must match the exact URL where users open the app (including port)
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 canonical URL (keep in sync with NEXTAUTH_URL)
AUTH_URL="http://localhost:3000"
# Explicit public HTTPS governance origin for project Telegram Mini App preview
# entry URLs. Do not infer this from AUTH_URL/NEXTAUTH_URL.
GOVERNANCE_PUBLIC_URL=""

# RA-344 rollout/readiness markers for standalone governance/VPS slots.
# Slot processes must set these explicitly; missing values keep /api/readiness
# in not_ready.
GOVERNANCE_BUILD_ID=""
GOVERNANCE_RELEASE_SHA=""
GOVERNANCE_SLOT_ID=""
GOVERNANCE_SCHEDULER_ROLE="active"
GOVERNANCE_MIGRATION_STATUS="not_required"

# Google OAuth Provider
# Get these credentials from: https://console.cloud.google.com/apis/credentials
# Steps to obtain credentials:
# 1. Create a new project or select an existing one
# 2. Go to "Credentials" in the APIs & Services section
# 3. Click "Create Credentials" > "OAuth 2.0 Client IDs"
# 4. Configure OAuth consent screen if not done already
# 5. For Application type, select "Web application"
# 6. Add authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google (for local dev)
#    - https://yourdomain.com/api/auth/callback/google (for production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram OIDC auth provider
# Create these in @BotFather via Login Widget -> Switch to OpenID Connect Login.
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""
# Non-secret bot id used by Project Interaction API to verify Telegram Mini App initData signatures.
TELEGRAM_WEBAPP_BOT_ID=""

# Admin Configuration
# Comma-separated list of email addresses that should have admin privileges
# Admins can deploy projects to production
# Users with these emails will be assigned the ADMIN role on first sign-in
# Example: ADMIN_EMAILS="admin@example.com,another@example.com"
ADMIN_EMAILS=""
# Optional: comma-separated numeric Telegram user ids that should receive the same bootstrap superadmin grant.
ADMIN_TELEGRAM_USER_IDS=""

# Platform secrets for standalone governance/VPS. For local Docker/devprod, prefer root .env.local.
SECRETS_ENCRYPTION_KEY=""
ARENA_ADMIN_SECRET=""
ARENA_PREVIEW_REFRESH_TOKEN=
ARENA_PREVIEW_REFRESH_PROJECT_IDS=

# Runner defaults
DEFAULT_PROJECT_BRANCH="main"

# GitHub token used by runner for clone/push and auto-repo creation
GITHUB_TOKEN=""

# Git transport for clone/push:
# - https (default): uses GITHUB_TOKEN
# - ssh: uses your local SSH key/agent (recommended for workflow file pushes)
RUNNER_GIT_TRANSPORT="https"

# Optional target owner for auto-created repositories (user or org).
# If empty, runner creates repos under the token owner's account.
RUNNER_GITHUB_OWNER=""

# Prefix for auto-created repo names (example: ralph-my-project-abc123)
RUNNER_GITHUB_REPO_PREFIX="arena"

# Visibility for auto-created repositories: "private" or "public"
RUNNER_GITHUB_REPO_VISIBILITY="private"

# Runner mode (codex or claude-code)
RUNNER_AGENT="codex"
# Auth modes (RA-053):
# CLAUDE_AUTH_MODE: oauth (subscription via authd) or api_key (pay-per-use via api-proxy)
# CODEX_AUTH_MODE: subscription (authd-owned Codex session) or api_key (OPENAI_API_KEY)
CLAUDE_AUTH_MODE="oauth"
CODEX_AUTH_MODE="subscription"
# Optional OpenCode Zen API key; current free Zen models also run without it.
OPENCODE_API_KEY=""
# API proxy URL for dispatcher host-side calls (health/register/unregister)
API_PROXY_URL="http://localhost:4100"
# API proxy URL injected into run containers for provider traffic accounting
API_PROXY_CONTAINER_URL="http://host.docker.internal:4100"

# Per-run containers: ephemeral Docker containers created for each run.
# Maximum number of concurrent runs (default: 3)
RUNNER_MAX_CONCURRENT_RUNS="3"
# If false, process env (e.g. docker-compose env) wins over .env/.env.local inside dispatcher
RUNNER_DOTENV_OVERRIDE="true"
# Docker image for workers (default: arena-public-worker:local)
RUNNER_WORKER_IMAGE="arena-public-worker:local"
# Per-worker container limits (set smaller values on budget VPS, e.g. 1g / 1.0)
RUNNER_WORKER_MEMORY="4g"
RUNNER_WORKER_CPUS="2.0"
# Domain for subdomain-based preview URLs (e.g. arena.example.test)
# Each run gets preview-{runId}.{PREVIEW_DOMAIN} routed by Caddy.
# Requires wildcard DNS: *.{domain} → VPS IP.
PREVIEW_DOMAIN="arena.example.test"
# adds system-managed e2e tasks only when plan has at least this many feature tasks.
# Set to 2+ to skip tiny single-task projects.
RALPH_E2E_ENFORCER_MIN_FEATURE_TASKS="2"

# Optional Langfuse mirror for Ralph Prompt Calls.
# Leave empty to keep PromptMap local-only.
LANGFUSE_BASE_URL=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Safety guard to prevent accidental runs against demo placeholder repos (github.com/example/*)
RUNNER_ALLOW_PLACEHOLDER_REPOS="false"

# Shared secret for internal worker/runner callbacks
RUNNER_WEBHOOK_SECRET=""

# API proxy management secret, forwarded to runner containers for proxy-backed platform credits.
API_PROXY_SECRET=""

# Shared secret for tg-spec -> Arena accepted-spec pushes
ARENA_PUSH_SECRET=""
TG_SPEC_INTERNAL_BASE_URL=""

# Secret for season cron endpoint: POST /api/cron/seasons
# If empty, cron endpoint is open (suitable for local dev)
CRON_SECRET=""

# Docker Configuration (optional, used for docker-compose)
# The port on which the application will be accessible on your host machine
# Default: 3000
APP_PORT=3000

# Production Configuration
# Set to true when deploying behind a proxy (e.g., nginx, Cloudflare)
# This ensures auth cookies work correctly with HTTPS
AUTH_TRUST_HOST=true

# RA-224: Cloudflare Web Analytics
# Get beacon token from: Cloudflare Dashboard → Web Analytics → Add site → arena.example.test
# Leave empty to disable analytics script
NEXT_PUBLIC_CF_BEACON_TOKEN=""

# RA-224: Email notifications (Resend)
# Get API key from: https://resend.com/api-keys
# Verify sending domain at: https://resend.com/domains
# Leave empty for dev mode (console.log instead of sending)
RESEND_API_KEY=""
# Sender address for transactional emails
RESEND_FROM_EMAIL="Arena <noreply@mail.arena.example.test>"
# Resend webhook signing secret (from Resend dashboard → Webhooks)
# Used to verify webhook payloads (open/click/bounce tracking)
RESEND_WEBHOOK_SECRET=""

# Freemius payments / Platform Credits
FREEMIUS_PRODUCT_ID=""
FREEMIUS_API_KEY=""
FREEMIUS_SECRET_KEY=""
FREEMIUS_PUBLIC_KEY=""
# live | sandbox. Missing means live; sandbox must be explicit.
FREEMIUS_CHECKOUT_MODE=""
