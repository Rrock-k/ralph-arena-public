{
  "name": "ralph-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contracts:prepare": "node scripts/ensure-contracts-build.mjs",
    "prisma:link": "node scripts/ensure-prisma-client-link.mjs",
    "predev": "npm run contracts:prepare && prisma generate && npm run prisma:link",
    "dev": "next dev --turbopack",
    "prebuild": "npm run contracts:prepare && prisma generate && npm run prisma:link",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "db:generate": "npm run contracts:prepare && prisma generate && npm run prisma:link",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "npm run contracts:prepare && prisma generate && npm run prisma:link",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:budget": "playwright test e2e/e2e-admin-budget-flow.spec.ts --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify:storybook:lab": "node scripts/verify-lab-storybook.mjs"
  },
  "dependencies": {
    "@arena/contracts": "file:../../packages/contracts",
    "@auth/prisma-adapter": "^2.11.1",
    "@freemius/checkout": "^1.4.1",
    "@freemius/sdk": "^0.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.56.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.15.0",
    "lucide-react": "^0.564.0",
    "marked": "^17.0.1",
    "next": "^16.2.7",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.18.0",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "svix": "^1.95.1",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "fast-uri": "3.1.2",
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-onboarding": "^10.4.2",
    "@storybook/addon-styling-webpack": "^3.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/nextjs": "^10.4.2",
    "@storybook/react-webpack5": "^10.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.33",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "better-sqlite3": "^12.6.2",
    "css-loader": "^7.1.3",
    "dotenv": "^17.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.14",
    "eslint-plugin-storybook": "^10.2.8",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.0",
    "storybook": "^10.4.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vitest": "^4.0.18"
  }
}
