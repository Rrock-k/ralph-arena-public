{
  "name": "@arena/worker-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');const path=require('node:path');const pkg=process.env.npm_package_json;fs.rmSync(path.join(path.dirname(pkg),'dist'),{ recursive: true, force: true });\" && tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/resource-pressure.test.ts"
  },
  "dependencies": {
    "@arena/contracts": "file:../../packages/contracts",
    "dockerode": "^5.0.0"
  },
  "overrides": {
    "@protobufjs/utf8": "1.1.1",
    "protobufjs": "7.6.2"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
