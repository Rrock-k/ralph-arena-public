FROM node:22-slim

ARG CODEX_CLI_VERSION=0.144.4
ARG CLAUDE_CODE_CLI_VERSION=2.1.212
ARG OPENCLAW_CLI_VERSION=2026.5.28
ARG OPENCODE_CLI_VERSION=1.16.2
ARG ANTIGRAVITY_CLI_VERSION=1.0.0

ENV ARENA_CODEX_CLI_VERSION="${CODEX_CLI_VERSION}"
ENV ARENA_CLAUDE_CODE_CLI_VERSION="${CLAUDE_CODE_CLI_VERSION}"
ENV ARENA_OPENCLAW_CLI_VERSION="${OPENCLAW_CLI_VERSION}"
ENV ARENA_OPENCODE_CLI_VERSION="${OPENCODE_CLI_VERSION}"
ENV ARENA_ANTIGRAVITY_CLI_VERSION="${ANTIGRAVITY_CLI_VERSION}"
ENV PLAYWRIGHT_BROWSERS_PATH="/home/node/.cache/ms-playwright"

# Install system dependencies for development tools (NO Docker - removed for security)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    openssh-client \
    build-essential \
    python3 \
    python-is-python3 \
    dbus-user-session \
    dbus-x11 \
    gnome-keyring \
    libsecret-tools \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# REMOVED: Docker CLI installation (no longer needed without Docker socket)

# Install CLI agents and bundled runtimes globally.
# These will use provider API-key env vars for authentication.
RUN npm install -g \
    "@openai/codex@${CODEX_CLI_VERSION}" \
    "@anthropic-ai/claude-code@${CLAUDE_CODE_CLI_VERSION}" \
    "openclaw@${OPENCLAW_CLI_VERSION}" \
    "opencode-ai@${OPENCODE_CLI_VERSION}"

# Install Antigravity CLI as agy from the checksum-pinned official tarball.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) \
        agy_url="https://storage.googleapis.com/antigravity-public/antigravity-cli/${ANTIGRAVITY_CLI_VERSION}-5288553236791296/linux-x64/cli_linux_x64.tar.gz"; \
        agy_sha="5ccdcc01fb863c7e8e56473c6c95dba75fed4fd2a242200d80cfc4c7fab811b733f5a7fab25332130aad298e72627e1018e6911a5658f4f059ef6e019f211972"; \
        ;; \
      arm64) \
        agy_url="https://storage.googleapis.com/antigravity-public/antigravity-cli/${ANTIGRAVITY_CLI_VERSION}-5288553236791296/linux-arm/cli_linux_arm64.tar.gz"; \
        agy_sha="9797c7955d0e07fc57605f81fab16dfd2f390d43b2508af3ca697b1cfa498e37e43a3a9a55ad8b26eb1353d80bbec522d108eb75a0eb0eb00e979cb579d6e277"; \
        ;; \
      *) \
        echo "Unsupported architecture for Antigravity CLI: $arch" >&2; \
        exit 1; \
        ;; \
    esac; \
    curl -fsSL -o /tmp/agy.tar.gz "$agy_url"; \
    echo "$agy_sha  /tmp/agy.tar.gz" | sha512sum -c -; \
    tar -xzf /tmp/agy.tar.gz -C /tmp antigravity; \
    install -m 0755 /tmp/antigravity /usr/local/bin/agy; \
    rm -f /tmp/agy.tar.gz /tmp/antigravity; \
    agy --version

COPY services/worker-agent/arena-agy-with-keyring.sh /usr/local/bin/arena-agy-with-keyring
RUN chmod 0755 /usr/local/bin/arena-agy-with-keyring
ENV ARENA_RAW_AGY_BIN="/usr/local/bin/agy"
ENV ARENA_ANTIGRAVITY_BIN="/usr/local/bin/arena-agy-with-keyring"

# Setup non-root user with sudo access
RUN echo "node ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/node && \
    chmod 0440 /etc/sudoers.d/node

# REMOVED: Docker group (no longer needed)

# Build shared contracts first; Ralph runtime depends on this package for
# canonical pricing and arena-runner consumes the same compiled dist.
COPY packages/contracts/package.json packages/contracts/package-lock.json /packages/contracts/
RUN cd /packages/contracts && npm ci
COPY packages/contracts/tsconfig.json /packages/contracts/
COPY packages/contracts/src/ /packages/contracts/src/
RUN cd /packages/contracts && npx tsc

# Build the bundled first-party Ralph runtime directly from the repo. Keep the
# repo-relative package layout so the lockfile's file:../../contracts link stays
# valid, then expose the historical /ralph path used by loop command templates.
WORKDIR /packages/loops/ralph-runtime
COPY packages/loops/ralph-runtime/package.json packages/loops/ralph-runtime/package-lock.json /packages/loops/ralph-runtime/
RUN npm ci

# Install Playwright system dependencies as root (for Ralph visual QA).
# Keep this before copying runtime source so normal Ralph code edits do not
# invalidate the heavy browser/dependency cache layer.
RUN npm exec --prefix /packages/loops/ralph-runtime -- playwright install-deps chromium

USER node

# Install platform-owned Playwright browsers as node user.
# Project workspaces must not install Chromium/Playwright browser infra locally.
RUN npm exec --prefix /packages/loops/ralph-runtime -- playwright install chromium && \
    node -e "const { chromium } = require('/packages/loops/ralph-runtime/node_modules/playwright'); process.stdout.write(chromium.executablePath())" > /tmp/arena-chromium-path

USER root

# Expose the platform-owned browser through the conventional executable path
# used by project-local smoke tests without installing a second OS Chromium.
RUN set -eux; \
    chromium_path="$(cat /tmp/arena-chromium-path)"; \
    test -x "$chromium_path"; \
    printf '#!/bin/sh\nexec "%s" "$@"\n' "$chromium_path" > /usr/local/bin/arena-chromium; \
    chmod 0755 /usr/local/bin/arena-chromium; \
    ln -sf /usr/local/bin/arena-chromium /usr/bin/chromium; \
    rm -f /tmp/arena-chromium-path

COPY packages/loops/ralph-runtime/tsconfig.json /packages/loops/ralph-runtime/
COPY packages/loops/ralph-runtime/src/ /packages/loops/ralph-runtime/src/
RUN npm run build && ln -s /packages/loops/ralph-runtime /ralph

# RA-083: Bundle prebuilt arena-runner dist from the local repo.
# This keeps the worker image aligned with the actual local build path used in devprod.
COPY services/arena-runner/dist/ /arena/
RUN mkdir -p /arena/node_modules/@arena/contracts && \
    cp -r /packages/contracts/dist/ /arena/node_modules/@arena/contracts/dist/ && \
    cp /packages/contracts/package.json /arena/node_modules/@arena/contracts/package.json && \
    cp -r /packages/contracts/node_modules/zod /arena/node_modules/zod

# Placeholder server (instant preview while agent works)
WORKDIR /app
COPY services/arena-runner/placeholder-server.cjs /app/placeholder-server.cjs

# Create workspace directory (runner clones repo here)
RUN mkdir -p /workspace && chown node:node /workspace

# RA-212: Runner needs to git clone loops into /arena/loops/ at runtime
RUN mkdir -p /arena/loops && chown node:node /arena/loops

ENV CHROME_BIN="/usr/bin/chromium"
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD="1"

USER node

# RA-083: Runner is PID 1 inside container
CMD ["node", "/arena/index.js"]
