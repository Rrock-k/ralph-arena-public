# ── Auth modes (required, no defaults) ────────────────────────
# CLAUDE_AUTH_MODE: oauth (subscription via authd) or api_key (pay-per-use via api-proxy)
# CODEX_AUTH_MODE:  subscription (authd-owned Codex session) or api_key (OPENAI_API_KEY)
CLAUDE_AUTH_MODE=oauth
CODEX_AUTH_MODE=subscription

# ── Governance app auth / bootstrap ───────────────────────────
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
ADMIN_TELEGRAM_USER_IDS=

# ── Claude credentials ────────────────────────────────────────
# oauth mode: authd native session is runtime truth; these are legacy/bootstrap inputs only
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_REFRESH_TOKEN=
# api_key mode: required
ANTHROPIC_API_KEY=

# ── Codex (OpenAI) credentials ────────────────────────────────
OPENAI_API_KEY=
# subscription mode: authd owns native Codex auth; runtime gets sanitized run auth
RUNNER_MOUNT_CODEX_CONFIG=false
RUNNER_CODEX_CONFIG_DIR=

# ── OpenCode Zen credentials (optional for current free Zen models) ─────
OPENCODE_API_KEY=

# ── Other credentials ─────────────────────────────────────────
GITHUB_TOKEN=
ZAI_AUTH_TOKEN=
SECRETS_ENCRYPTION_KEY=
ARENA_ADMIN_SECRET=
ARENA_PREVIEW_REFRESH_TOKEN=
ARENA_PREVIEW_REFRESH_PROJECT_IDS=
RUNNER_WEBHOOK_SECRET=
AUTHD_SECRET=
ARENA_PUSH_SECRET=
TG_SPEC_INTERNAL_BASE_URL=

# ── Telegram OIDC auth provider ───────────────────────────────
# Create these in @BotFather via Login Widget -> Switch to OpenID Connect Login.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Non-secret bot id for Telegram Mini App initData signature verification.
TELEGRAM_WEBAPP_BOT_ID=

# ── API proxy (active when CLAUDE_AUTH_MODE=api_key) ──────────
API_PROXY_URL=http://localhost:4100
API_PROXY_CONTAINER_URL=http://host.docker.internal:4100
API_PROXY_SECRET=

# ── Runner config ─────────────────────────────────────────────
RUNNER_MAX_CONCURRENT_RUNS=3
# Optional override; empty uses $ARENA_HOME_PATH/.arena-runtime/project-data.
ARENA_PROJECT_DATA_ROOT=
RUNNER_WORKER_MEMORY=4g
RUNNER_WORKER_CPUS=2.0
PREVIEW_DOMAIN=localhost:8080
# Public HTTPS governance origin used for Telegram Mini App preview entry URLs.
# Leave empty for local-only preview runs.
GOVERNANCE_PUBLIC_URL=
# Explicit rollout/readiness markers for production-shaped local/devprod runs.
GOVERNANCE_BUILD_ID=
GOVERNANCE_RELEASE_SHA=
GOVERNANCE_SLOT_ID=
# Governance scheduler owner for the currently active local/devprod service.
# Allowed values: active, standby, external.
GOVERNANCE_SCHEDULER_ROLE=active
GOVERNANCE_MIGRATION_STATUS=not_required
RALPH_E2E_ENFORCER_MIN_FEATURE_TASKS=2

# ── Optional Langfuse prompt-call mirror ──────────────────────
# Leave empty to keep PromptMap local-only.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Agent CLI versions baked into worker/authd images ─────────
# Keep exact versions here; "latest" is not operator truth.
CODEX_CLI_VERSION=0.144.4
CLAUDE_CODE_CLI_VERSION=2.1.212
OPENCLAW_CLI_VERSION=2026.5.28
OPENCODE_CLI_VERSION=1.16.2
ANTIGRAVITY_CLI_VERSION=1.0.0

# Explicit DB backup root used by the RA-304 fixed pg_dump executor.
# Defaults to repo-local runtime/db-backups through scripts/docker-local-stack.sh.
# Override only with an absolute path that should be mounted into governance-platform.
ARENA_DB_BACKUP_ROOT=
ARENA_DB_BACKUP_INTERVAL_MS=21600000
ARENA_DB_BACKUP_INITIAL_DELAY_MS=300000
ARENA_DB_BACKUP_KEEP_ALL_HOURS=48
ARENA_DB_BACKUP_KEEP_DAILY_DAYS=14
ARENA_DB_BACKUP_KEEP_WEEKLY_WEEKS=8
ARENA_DB_BACKUP_KEEP_MONTHLY_MONTHS=6

# ── VPS worker connectivity ─────────────────────────────────
# Option A (prod): set public API proxy URL directly if a remote worker host needs it
# VPS_API_PROXY_CONTAINER_URL=https://api-proxy.arena.example.test
# Option B (local dev): auto-start a cloudflared tunnel for the API proxy
# VPS_TUNNEL_PROXY_TARGET=http://api-proxy:4100

# ── VPS Backend (RA-037, project.runnerBackend = "vps") ──────
HETZNER_API_TOKEN=
HETZNER_DNS_TOKEN=
HETZNER_DNS_ZONE_ID=
VPS_PREVIEW_BASE_DOMAIN=local  # "local" for IP-based access (no domain/Caddy), or a real domain e.g. "arena.example.test"
VPS_WORKER_IMAGE=
VPS_DEFAULT_REGION=nbg1
VPS_DEFAULT_SERVER_TYPE=cx23
VPS_ACME_EMAIL=

# ── Freemius (Payments — RA-130) ──────────────────────────────
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
# live | sandbox. Missing means live; sandbox must be explicit.
FREEMIUS_CHECKOUT_MODE=

# ── Notifications / analytics ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Arena <noreply@mail.arena.example.test>"
RESEND_WEBHOOK_SECRET=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ── Arena bot ─────────────────────────────────────────────────
# Separate from project TELEGRAM_BOT_TOKEN. The first module sends only the
# automation-authored Operator digest from the local Codex automation memory.
ARENA_BOT_TELEGRAM_TOKEN=
ARENA_BOT_TELEGRAM_CHAT_ID=
# Empty uses ~/.codex/automations.
ARENA_BOT_AUTOMATIONS_DIR=
# docker-local-stack fills this with local default sources. Direct compose with
# an empty value keeps the legacy single-source weekly digest path.
# Comma-separated in-container paths enable multiple ready-made digest sources.
ARENA_BOT_DIGEST_SOURCE_FILES=
# Empty disables age-based skipping. docker-local-stack defaults this to 48h.
ARENA_BOT_DIGEST_MAX_AGE_HOURS=
# Empty uses ~/.codex/automations/ralph-weekly-instruction-maintenance.
ARENA_BOT_WEEKLY_DIGEST_AUTOMATION_DIR=
ARENA_BOT_WEEKLY_DIGEST_POLL_INTERVAL_MS=30000
