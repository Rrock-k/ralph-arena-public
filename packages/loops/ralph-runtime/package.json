  "dependencies": {
    "@arena/contracts": "file:../../contracts",
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@octokit/rest": "^21.0.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.3.0",
    "fs-extra": "^11.2.0",
    "openai": "^4.104.0",
    "ora": "^8.0.1",
    "playwright": "^1.60.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.22.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.26.1"
