{
  "name": "@arena/ralph-runtime",
  "version": "1.3.0",
  "description": "Bundled first-party Ralph loop runtime for Arena",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "ralph": "tsx src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
