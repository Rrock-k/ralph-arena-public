# Wildcard subdomain routing for preview containers.
# Caddy runs on arena-public-network alongside preview-{runId} containers.
#
# DNS prerequisite:
#   arena.example.test      A  {VPS_IP}
#   *.arena.example.test    A  {VPS_IP}
#
# Env vars (set in docker-compose.caddy.yml):
#   PREVIEW_DOMAIN — e.g. arena.example.test
#   ACME_EMAIL     — e.g. admin@arena.example.test

(preview_no_store) {
	header_down Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header_down CDN-Cache-Control "no-store"
	header_down Cloudflare-CDN-Cache-Control "no-store"
	header_down Pragma "no-cache"
	header_down Expires "0"
}

(preview_response_no_store) {
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header CDN-Cache-Control "no-store"
	header Cloudflare-CDN-Cache-Control "no-store"
	header Pragma "no-cache"
	header Expires "0"
}

{$PREVIEW_DOMAIN}, app.{$PREVIEW_DOMAIN} {
	@admin_ctl path /api/admin/ctl /api/admin/ctl/*

	handle @admin_ctl {
		respond "Not found" 404
	}

	@telegramWebAppAuth path /api/telegram/webapp-session /api/telegram/webapp-link
	handle @telegramWebAppAuth {
		reverse_proxy governance-platform:3000 {
			header_down Cache-Control "no-cache, no-store, must-revalidate"
		}
	}

	# RA-223: Prevent stale HTML/API responses in browser cache.
	# _next/static/* keeps Next.js immutable headers (content-hashed filenames).
	# Everything else gets no-cache = always revalidate (304 if unchanged, fast).
	@notStatic not path /_next/static/*
	handle @notStatic {
		reverse_proxy governance-platform:3000 {
			header_down Cache-Control "no-cache"
		}
	}

	@isStatic path /_next/static/*
	handle @isStatic {
		reverse_proxy governance-platform:3000
	}

	handle_errors {
		@maintenance expression `{err.status_code} in [502, 503, 504]`
		handle @maintenance {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-cache"
			respond `<!DOCTYPE html><html lang=en><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><meta http-equiv=refresh content=5><title>Ralph Arena — Updating</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0b0f19;color:#e2e8f0;display:flex;align-items:center;justify-content:center;min-height:100vh}.card{text-align:center;padding:40px 32px;max-width:400px}.logo{font-size:24px;font-weight:700;letter-spacing:-.5px;margin-bottom:32px;color:#fff}.logo span{color:#10b981}.spinner{width:32px;height:32px;border:3px solid #1e293b;border-top-color:#10b981;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 24px}@keyframes spin{to{transform:rotate(360deg)}}h1{font-size:18px;font-weight:600;margin-bottom:8px}p{font-size:13px;color:#94a3b8;line-height:1.6}</style></head><body><div class=card><div class=logo>Ralph <span>Arena</span></div><div class=spinner></div><h1>Updating</h1><p>The app is restarting. This page will refresh automatically.</p></div></body></html>` 200
		}
	}
}

# RA-066: Internal services exposed for VPS containers.
# Auth is handled at the service level (x-proxy-secret header).
api-proxy.{$PREVIEW_DOMAIN} {
	tls {$ACME_EMAIL}
	reverse_proxy api-proxy:4100
}

tg.{$PREVIEW_DOMAIN} {
	tls {$ACME_EMAIL}
	reverse_proxy {$TG_SPEC_EDGE_UPSTREAM:host.docker.internal:3022}
}

*.{$PREVIEW_DOMAIN} {
	tls {$ACME_EMAIL}
	import preview_response_no_store

	# Strip iframe-blocking headers set by agent-built apps so governance
	# can embed previews in iframes (cards, project page, etc.).
	header -X-Frame-Options
	header -Content-Security-Policy

	# RA-210/RA-366: Strip client-sent identity/access headers to prevent spoofing.
	# Real user identity is never forwarded — only preview-gate-issued anon/project headers.
	request_header -X-Ralph-User-Id
	request_header -X-Ralph-User-Email
	request_header -X-Ralph-User-Role
	request_header -X-Ralph-Anon-Id
	request_header -X-Arena-Project-Id
	request_header -X-Arena-Project-Role
	request_header -X-Arena-Project-Capabilities

	@preview_websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @preview_websocket {
		forward_auth governance-platform:3000 {
			uri /api/auth/preview-gate?host={host}
			copy_headers X-Ralph-Anon-Id X-Arena-Project-Id X-Arena-Project-Role X-Arena-Project-Capabilities
		}

		reverse_proxy {labels.2}:3000
	}

	handle /sw.js {
		# RA-263: serve a runner-owned wrapper whose bytes change with git HEAD.
		# This lets real project service workers update when preview code changes.
		forward_auth governance-platform:3000 {
			uri /api/auth/preview-gate?host={host}
			copy_headers X-Ralph-Anon-Id X-Arena-Project-Id X-Arena-Project-Role X-Arena-Project-Capabilities
		}

		reverse_proxy {labels.2}:3999 {
			import preview_no_store
		}
	}

	handle /__arena/preview-generation {
		forward_auth governance-platform:3000 {
			uri /api/auth/preview-gate?host={host}
			copy_headers X-Ralph-Anon-Id X-Arena-Project-Id X-Arena-Project-Role X-Arena-Project-Capabilities
		}

		reverse_proxy {labels.2}:3999 {
			import preview_no_store
		}
	}

	handle /__arena/project-sw.js {
		forward_auth governance-platform:3000 {
			uri /api/auth/preview-gate?host={host}
			copy_headers X-Ralph-Anon-Id X-Arena-Project-Id X-Arena-Project-Role X-Arena-Project-Capabilities
		}

		rewrite * /sw.js
		reverse_proxy {labels.2}:3000 {
			import preview_no_store
		}
	}

	handle {
		# RA-210: Auth gate — governance checks visibility + consent/auth cookies.
		# On 200: pass through with anon ID. On 403: interstitial page.
		forward_auth governance-platform:3000 {
			uri /api/auth/preview-gate?host={host}
			copy_headers X-Ralph-Anon-Id X-Arena-Project-Id X-Arena-Project-Role X-Arena-Project-Capabilities
		}

		# Extract subdomain and route to the matching container on arena-public-network.
		# For preview-abc123.arena.example.test → reverse_proxy preview-abc123:3000
		# Caddy label indexing: {labels.2} is the leftmost part of the hostname.
		reverse_proxy {labels.2}:3000 {
			import preview_no_store
		}
	}
}
